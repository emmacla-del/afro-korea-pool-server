generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SUPPLIER
  ADMIN
}

enum PoolStatus {
  OPEN
  PAYMENT_WINDOW
  PURCHASED
  FAILED_PAYMENT
  EXPIRED
}

enum CommitmentStatus {
  ACTIVE
  PAID
  EXPIRED
  CANCELED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

enum PurchaseOrderSource {
  POOL
  DIRECT
}

enum PurchaseOrderStatus {
  PENDING_SUPPLIER_CONFIRM
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DealType {
  MOQ_POOL
  TEAM_DEAL
}

enum ProductCategory {
  FOOD_PRODUCE
  TRANSFORMED_FOOD
  HOUSEHOLD_EQUIPMENT
  CONSTRUCTION_MATERIAL
  ELECTRONICS
}

// 👇 NEW: Neighbourhood model
model Neighbourhood {
  id        String   @id @default(uuid())
  name      String   @unique
  users     User[]   // users belonging to this neighbourhood
  pools     Pool[]   // deals restricted to this neighbourhood
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  name      String?
  phone     String?  @unique
  password  String
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 👇 NEW: neighbourhood relation
  neighbourhoodId String?
  neighbourhood   Neighbourhood? @relation(fields: [neighbourhoodId], references: [id])

  supplier    Supplier?
  commitments Commitment[] @relation("UserCommitments")
  orders      Order[]      @relation("UserOrders")
  checkIns    UserCheckIn[]

  referrerId   String?
  referrer     User?        @relation("UserReferrals", fields: [referrerId], references: [id])
  referrals    User[]       @relation("UserReferrals")
  referralCode String?      @unique
  rewardBalance Int         @default(0)

  superCreatorId String?
  superCreator   User?       @relation("TeamCreatorSuper", fields: [superCreatorId], references: [id])
  teamCreators   User[]      @relation("TeamCreatorSuper")

  rewardTransactions RewardTransaction[] @relation("UserRewardTransactions")
  referredCommitments Commitment[]        @relation("CommitmentReferrer")
  createdPools       Pool[]               @relation("PoolCreator")

  referrerTransactions ReferralTransaction[] @relation("ReferrerLinks")
  refereeTransactions ReferralTransaction[] @relation("RefereeLinks")
}

model Supplier {
  id                 String             @id @default(uuid())
  ownerUserId        String             @unique
  displayName        String
  country            String
  city               String?
  verificationStatus VerificationStatus @default(PENDING)
  businessRegNumber  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User            @relation(fields: [ownerUserId], references: [id])
  products       Product[]       @relation("SupplierProducts")
  purchaseOrders PurchaseOrder[]
  orders         Order[]         @relation("SupplierOrders")

  @@index([verificationStatus])
}

model Product {
  id          String   @id @default(uuid())
  supplierId  String
  title       String
  description String?
  category    String?
  catEnum     ProductCategory?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier    Supplier         @relation("SupplierProducts", fields: [supplierId], references: [id])
  variants    ProductVariant[] @relation("ProductVariants")
  images      Image[]          @relation("ProductImages")
}

model ProductVariant {
  id           String   @id @default(uuid())
  productId    String
  sku          String   @unique
  unitPriceXaf Int
  thresholdQty Int
  leadTimeDays Int      @default(14)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation("ProductVariants", fields: [productId], references: [id])
  pools   Pool[]  @relation("VariantPools")
  orders  Order[] @relation("VariantOrders")
}

model Image {
  id        String   @id @default(uuid())
  product   Product  @relation("ProductImages", fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  order     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model Pool {
  id                   String     @id @default(uuid())
  variantId            String?
  dealType             DealType   @default(MOQ_POOL)
  thresholdQtySnapshot Int
  committedQty         Int        @default(0)
  minBuyers            Int?
  currentBuyers        Int?       @default(0)
  teamPrice            Int?
  unitPriceXafSnapshot Int
  status               PoolStatus @default(OPEN)
  deadlineAt           DateTime
  lockedAt             DateTime?
  paymentWindowEndsAt  DateTime?
  paidQty              Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  creatorId      String?
  creator        User?            @relation("PoolCreator", fields: [creatorId], references: [id])
  rewardQuantity Int?

  // 👇 NEW: neighbourhood relation
  neighbourhoodId String?
  neighbourhood   Neighbourhood? @relation(fields: [neighbourhoodId], references: [id])

  variant        ProductVariant?  @relation("VariantPools", fields: [variantId], references: [id])
  commitments    Commitment[]     @relation("PoolCommitments")
  purchaseOrder  PurchaseOrder?
  orders         Order[]          @relation("PoolOrders")

  @@index([variantId])
  @@index([status, deadlineAt])
  @@index([status, paymentWindowEndsAt])
}

model Commitment {
  id        String           @id @default(uuid())
  poolId    String
  userId    String
  qty       Int
  status    CommitmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  referrerId String?
  referrer   User?       @relation("CommitmentReferrer", fields: [referrerId], references: [id])

  pool Pool @relation("PoolCommitments", fields: [poolId], references: [id])
  user User @relation("UserCommitments", fields: [userId], references: [id])
  order Order?

  @@unique([poolId, userId])
  @@index([poolId])
  @@index([userId])
}

model Order {
  id           String      @id @default(uuid())
  userId       String
  supplierId   String
  variantId    String?
  qty          Int
  poolId       String?
  commitmentId String?     @unique
  unitPriceXaf Int
  amountXaf    Int
  status       OrderStatus @default(PENDING_PAYMENT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  deliveryMethod  String?
  pickupPoint     String?
  deliveryAddress String?

  pool       Pool?           @relation("PoolOrders", fields: [poolId], references: [id])
  commitment Commitment?     @relation(fields: [commitmentId], references: [id])
  payments   Payment[]       @relation("OrderPayments")
  purchaseOrder PurchaseOrder? @relation("DirectOrder")
  user       User            @relation("UserOrders", fields: [userId], references: [id])
  supplier   Supplier        @relation("SupplierOrders", fields: [supplierId], references: [id])
  variant    ProductVariant? @relation("VariantOrders", fields: [variantId], references: [id])

  @@index([userId, createdAt])
  @@index([supplierId, createdAt])
  @@index([poolId])
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String
  provider    String
  providerRef String?
  status      PaymentStatus @default(PENDING)
  amountXaf   Int
  rawWebhook  Json?
  createdAt   DateTime      @default(now())

  order Order @relation("OrderPayments", fields: [orderId], references: [id])

  @@index([orderId])
  @@unique([provider, providerRef])
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  supplierId    String
  source        PurchaseOrderSource @default(POOL)
  poolId        String?             @unique
  directOrderId String?             @unique
  status        PurchaseOrderStatus @default(PENDING_SUPPLIER_CONFIRM)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  supplier    Supplier           @relation(fields: [supplierId], references: [id])
  pool        Pool?              @relation(fields: [poolId], references: [id])
  directOrder Order?             @relation("DirectOrder", fields: [directOrderId], references: [id])
  items       PurchaseOrderItem[]
  events      FulfillmentEvent[]
}

model PurchaseOrderItem {
  id              String @id @default(uuid())
  purchaseOrderId String
  variantId       String
  qty             Int
  unitPriceXaf    Int

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
}

model FulfillmentEvent {
  id              String   @id @default(uuid())
  purchaseOrderId String
  status          String
  trackingCode    String?
  note            String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
}

model UserCheckIn {
  id          String   @id @default(uuid())
  userId      String
  checkInDate DateTime @default(now())
  reward      Int?
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, checkInDate])
}

model Reward {
  id          String   @id @default(uuid())
  title       String
  amount      Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReferralTransaction {
  id          String   @id @default(uuid())
  referrerId  String
  refereeId   String
  amount      Int
  status      String   @default("COMPLETED")
  createdAt   DateTime @default(now())

  referrer    User     @relation("ReferrerLinks", fields: [referrerId], references: [id])
  referee     User     @relation("RefereeLinks", fields: [refereeId], references: [id])
}

model RewardTransaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("UserRewardTransactions", fields: [userId], references: [id])
  amount      Int
  type        String   @default("OTHER")
  description String
  referenceId String?
  createdAt   DateTime @default(now())

  @@index([type])
}