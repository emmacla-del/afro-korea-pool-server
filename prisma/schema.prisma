generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SUPPLIER
  ADMIN
}

enum PoolStatus {
  OPEN
  PAYMENT_WINDOW
  PURCHASED
  FAILED_PAYMENT
  EXPIRED
}

enum CommitmentStatus {
  ACTIVE
  PAID
  EXPIRED
  CANCELED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

enum PurchaseOrderSource {
  POOL
  DIRECT
}

enum PurchaseOrderStatus {
  PENDING_SUPPLIER_CONFIRM
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DealType {
  MOQ_POOL
  TEAM_DEAL
}

// NEW: Product categories
enum ProductCategory {
  FOOD_PRODUCE
  TRANSFORMED_FOOD
  HOUSEHOLD_EQUIPMENT
  CONSTRUCTION_MATERIAL
  ELECTRONICS
}

model User {
  id        String   @id @default(uuid())
  name      String?  // 👈 NEW: user's display name
  phone     String?  @unique
  password  String
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier    Supplier?
  commitments Commitment[]
  orders      Order[]
  checkIns    UserCheckIn[]

  // 👇 NEW referral and reward fields
  referrerId        String?                // who referred this user
  referrer          User?        @relation("UserReferrals", fields: [referrerId], references: [id])
  referrals         User[]       @relation("UserReferrals")
  referralCode      String?       @unique
  rewardBalance     Int           @default(0)

  // 👇 NEW TC/STC hierarchy
  superCreatorId    String?                 // if this user is a TC under an STC
  superCreator      User?        @relation("TeamCreatorSuper", fields: [superCreatorId], references: [id])
  teamCreators      User[]       @relation("TeamCreatorSuper")

  // 👇 NEW relations for reverse lookups
  rewardTransactions RewardTransaction[]
  referredCommitments Commitment[]        @relation("CommitmentReferrer") // commitments where this user is the referrer
  createdPools       Pool[]               @relation("PoolCreator")       // pools created by this user (as TC)
}

model Supplier {
  id                 String             @id @default(uuid())
  ownerUserId        String             @unique
  displayName        String
  country            String
  city               String?
  verificationStatus VerificationStatus @default(PENDING)
  businessRegNumber  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User            @relation(fields: [ownerUserId], references: [id])
  products       Product[]
  purchaseOrders PurchaseOrder[]
  orders         Order[]

  @@index([verificationStatus])
}

model Product {
  id          String   @id @default(uuid())
  supplierId  String
  title       String
  description String?
  category    String?            // can keep as string, or migrate to enum later
  // 👇 NEW: enum category (optional, can be used for new products)
  catEnum     ProductCategory?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier Supplier         @relation(fields: [supplierId], references: [id])
  variants ProductVariant[]
  images   Image[]
}

model ProductVariant {
  id           String   @id @default(uuid())
  productId    String
  sku          String   @unique
  unitPriceXaf Int
  thresholdQty Int
  leadTimeDays Int      @default(14)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  pools   Pool[]
  orders  Order[]
}

model Image {
  id        String   @id @default(uuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  order     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model Pool {
  id                   String     @id @default(uuid())
  variantId            String?
  dealType             DealType   @default(MOQ_POOL)
  thresholdQtySnapshot Int
  committedQty         Int        @default(0)
  minBuyers            Int?
  currentBuyers        Int?       @default(0)
  teamPrice            Int?
  unitPriceXafSnapshot Int
  status               PoolStatus @default(OPEN)
  deadlineAt           DateTime
  lockedAt             DateTime?
  paymentWindowEndsAt  DateTime?
  paidQty              Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  // 👇 NEW: creator (TC) and reward fields
  creatorId     String?
  creator       User?     @relation("PoolCreator", fields: [creatorId], references: [id])
  rewardQuantity Int?     // e.g., free kg after reaching target

  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  commitments   Commitment[]
  purchaseOrder PurchaseOrder?
  orders        Order[]

  @@index([variantId])
  @@index([status, deadlineAt])
  @@index([status, paymentWindowEndsAt])
}

model Commitment {
  id        String           @id @default(uuid())
  poolId    String
  userId    String
  qty       Int
  status    CommitmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // 👇 NEW: who referred this user to this pool
  referrerId String?
  referrer   User?     @relation("CommitmentReferrer", fields: [referrerId], references: [id])

  pool  Pool  @relation(fields: [poolId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  order Order?

  @@unique([poolId, userId])
  @@index([poolId])
  @@index([userId])
}

model Order {
  id           String      @id @default(uuid())
  userId       String
  supplierId   String
  variantId    String?
  qty          Int
  poolId       String?
  commitmentId String?     @unique
  unitPriceXaf Int
  amountXaf    Int
  status       OrderStatus @default(PENDING_PAYMENT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // 👇 NEW delivery options
  deliveryMethod String?   // 'pickup', 'direct'
  pickupPoint    String?   // community center or address
  deliveryAddress String?

  pool          Pool?           @relation(fields: [poolId], references: [id])
  commitment    Commitment?     @relation(fields: [commitmentId], references: [id])
  payments      Payment[]
  purchaseOrder PurchaseOrder?  @relation("DirectOrder")
  user          User            @relation(fields: [userId], references: [id])
  supplier      Supplier        @relation(fields: [supplierId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([userId, createdAt])
  @@index([supplierId, createdAt])
  @@index([poolId])
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String
  provider    String
  providerRef String?
  status      PaymentStatus @default(PENDING)
  amountXaf   Int
  rawWebhook  Json?
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@unique([provider, providerRef])
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  supplierId    String
  source        PurchaseOrderSource @default(POOL)
  poolId        String?             @unique
  directOrderId String?             @unique
  status        PurchaseOrderStatus @default(PENDING_SUPPLIER_CONFIRM)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  supplier    Supplier           @relation(fields: [supplierId], references: [id])
  pool        Pool?              @relation(fields: [poolId], references: [id])
  directOrder Order?             @relation("DirectOrder", fields: [directOrderId], references: [id])
  items       PurchaseOrderItem[]
  events      FulfillmentEvent[]

  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String @id @default(uuid())
  purchaseOrderId String
  variantId       String
  qty             Int
  unitPriceXaf    Int

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
}

model FulfillmentEvent {
  id              String   @id @default(uuid())
  purchaseOrderId String
  status          String
  trackingCode    String?
  note            String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
}

model UserCheckIn {
  id          String   @id @default(uuid())
  userId      String
  checkInDate DateTime @default(now())
  reward      Int?
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, checkInDate])
}

// NEW: Reward transaction model
model RewardTransaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Int      // positive for credit, negative for debit
  description String   // e.g., "Referred a friend", "Campaign commission"
  referenceId String?  // optional link to campaign/order/pool
  createdAt   DateTime @default(now())
}
