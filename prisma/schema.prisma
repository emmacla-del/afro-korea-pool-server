generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  CUSTOMER
  SUPPLIER
  ADMIN
}

enum PoolStatus {
  OPEN
  PAYMENT_WINDOW
  PURCHASED
  FAILED_PAYMENT
  EXPIRED
}

enum CommitmentStatus {
  ACTIVE
  PAID
  EXPIRED
  CANCELED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

enum PurchaseOrderSource {
  POOL
  DIRECT
}

enum PurchaseOrderStatus {
  PENDING_SUPPLIER_CONFIRM
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum DealType {
  MOQ_POOL
  TEAM_DEAL
}

enum DeliveryType {
  HUB_PICKUP
  SATELLITE_HOME
  SATELLITE_HUB
}

// ── NEW: InteractionType used by InteractionService / ProductService ──────────
enum InteractionType {
  VIEW
  LIKE
  SHARE
}

// ==================== CATEGORIES ====================

model Category {
  id        String   @id @default(uuid())
  name      String
  emoji     String
  slug      String   @unique
  imageUrl  String?                        // 🔥 Added: used by getTopCategories() in HomeService
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

// ==================== GEOGRAPHIC HIERARCHY ====================

model Region {
  id        String     @id @default(uuid())
  name      String     @unique
  divisions Division[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Division {
  id             String          @id @default(uuid())
  name           String
  regionId       String
  region         Region          @relation(fields: [regionId], references: [id])
  neighbourhoods Neighbourhood[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([name, regionId])
}

model Neighbourhood {
  id         String   @id @default(uuid())
  name       String
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id])

  users     User[]
  pools     Pool[]
  suppliers Supplier[] @relation("SupplierNeighbourhood") // 🔥 Added: suppliers filter by neighbourhood

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, divisionId])
}

// ==================== USER & ROLES ====================

model User {
  id        String   @id @default(uuid())
  name      String?
  phone     String?  @unique
  password  String
  role      UserRole @default(CUSTOMER)
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  neighbourhoodId String?
  neighbourhood   Neighbourhood? @relation(fields: [neighbourhoodId], references: [id])

  supplier    Supplier?
  commitments Commitment[] @relation("UserCommitments")
  orders      Order[]      @relation("UserOrders")
  checkIns    UserCheckIn[]

  referrerId   String?
  referrer     User?   @relation("UserReferrals", fields: [referrerId], references: [id])
  referrals    User[]  @relation("UserReferrals")
  referralCode String? @unique
  rewardBalance Int    @default(0)

  rewardBalance Int    @default(0)
  totalPoints   Int    @default(0)   // 👈 add this
  checkinStreak Int    @default(0)   // 👈 add this
  
  superCreatorId String?
  superCreator   User?   @relation("TeamCreatorSuper", fields: [superCreatorId], references: [id])
  teamCreators   User[]  @relation("TeamCreatorSuper")

  rewardTransactions  RewardTransaction[]  @relation("UserRewardTransactions")
  referredCommitments Commitment[]         @relation("CommitmentReferrer")
  createdPools        Pool[]               @relation("PoolCreator")

  referrerTransactions ReferralTransaction[] @relation("ReferrerLinks")
  refereeTransactions  ReferralTransaction[] @relation("RefereeLinks")

  pushTokens     PushToken[]         @relation("UserPushTokens")
  notifications  InAppNotification[] @relation("UserNotifications")
  whatsappOptOut Boolean             @default(false)

  // 🔥 Added: required by InteractionService / ProductService personalisation
  interactions UserProductInteraction[]
}

model Supplier {
  id                 String             @id @default(uuid())
  ownerUserId        String             @unique
  displayName        String
  country            String
  city               String?
  description        String?                        // 🔥 Added: returned by getProductById supplier select
  verificationStatus VerificationStatus @default(UNVERIFIED)
  businessRegNumber  String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // 🔥 Added: supplier neighbourhood (used in ProductService neighbourhoodId filter)
  neighbourhoodId String?
  neighbourhood   Neighbourhood? @relation("SupplierNeighbourhood", fields: [neighbourhoodId], references: [id])

  owner          User            @relation(fields: [ownerUserId], references: [id])
  products       Product[]       @relation("SupplierProducts")
  purchaseOrders PurchaseOrder[]
  orders         Order[]         @relation("SupplierOrders")

  @@index([verificationStatus])
  @@index([neighbourhoodId])    // 🔥 Added: speeds up neighbourhood-based product filtering
}

// ==================== PRODUCT & INVENTORY ====================

model Product {
  id          String   @id @default(uuid())
  supplierId  String
  title       String
  description String?
  category    String?  // legacy free-text label — kept for backwards compat
  categoryId  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 🔥 Added: used by ProductService price sort and updateMinPrice()
  minPrice    Int?

  supplier   Supplier         @relation("SupplierProducts", fields: [supplierId], references: [id])
  category_  Category?        @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[] @relation("ProductVariants")
  images     Image[]          @relation("ProductImages")

  // 🔥 Added: used by ProductService popularity/trending sort and admin analytics
  stats        ProductStats?
  pools        Pool[]                   @relation("ProductPools")
  interactions UserProductInteraction[]

  @@index([supplierId])
  @@index([categoryId])
  @@index([isActive, createdAt])
  @@index([minPrice])            // 🔥 Added: price sort index
}

model ProductVariant {
  id           String   @id @default(uuid())
  productId    String
  sku          String   @unique
  unitPriceXaf Int
  thresholdQty Int
  leadTimeDays Int      @default(14)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product Product         @relation("ProductVariants", fields: [productId], references: [id])
  pools   Pool[]          @relation("VariantPools")
  orders  Order[]         @relation("VariantOrders")

  @@index([productId])
}

model Image {
  id        String   @id @default(uuid())
  productId String
  url       String
  order     Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation("ProductImages", fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// 🔥 NEW: Product popularity & trending score — used by ProductService sort
model ProductStats {
  id        String  @id @default(uuid())
  productId String  @unique
  score     Float   @default(0)   // weighted engagement score
  views     Int     @default(0)
  likes     Int     @default(0)
  shares    Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([score])
}

// 🔥 NEW: Individual interaction events — used by InteractionService and
//         ProductService collaborative filtering for personalised recommendations
model UserProductInteraction {
  id        String          @id @default(uuid())
  userId    String
  productId String
  type      InteractionType
  createdAt DateTime        @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@index([userId, productId])   // 🔥 speeds up "products this user has seen"
  @@index([productId, userId])   // 🔥 speeds up "users who saw this product"
}

// ==================== AGGREGATION & POOLS ====================

model Pool {
  id                   String     @id @default(uuid())
  variantId            String?
  dealType             DealType   @default(MOQ_POOL)
  thresholdQtySnapshot Int
  committedQty         Int        @default(0)
  minBuyers            Int?
  currentBuyers        Int?       @default(0)
  teamPrice            Int?
  unitPriceXafSnapshot Int
  status               PoolStatus @default(OPEN)
  deadlineAt           DateTime
  lockedAt             DateTime?
  paymentWindowEndsAt  DateTime?
  paidQty              Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  creatorId      String?
  creator        User?          @relation("PoolCreator", fields: [creatorId], references: [id])
  rewardQuantity Int?

  neighbourhoodId String?
  neighbourhood   Neighbourhood? @relation(fields: [neighbourhoodId], references: [id])

  hubAddress      String?
  hubContactPhone String?
  hubName         String?

  // 🔥 Added: direct Product relation (used in ProductService pool include + admin analytics)
  productId String?
  product   Product? @relation("ProductPools", fields: [productId], references: [id])

  variant       ProductVariant?  @relation("VariantPools", fields: [variantId], references: [id])
  commitments   Commitment[]     @relation("PoolCommitments")
  purchaseOrder PurchaseOrder?
  orders        Order[]          @relation("PoolOrders")

  @@index([variantId])
  @@index([productId])           // 🔥 Added
  @@index([status, deadlineAt])
  @@index([status, paymentWindowEndsAt])
}

model Commitment {
  id        String           @id @default(uuid())
  poolId    String
  userId    String
  qty       Int
  status    CommitmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  referrerId String?
  referrer   User?  @relation("CommitmentReferrer", fields: [referrerId], references: [id])

  pool  Pool       @relation("PoolCommitments", fields: [poolId], references: [id])
  user  User       @relation("UserCommitments", fields: [userId], references: [id])
  order Order?

  @@unique([poolId, userId])
  @@index([poolId])
  @@index([userId])
}

// ==================== TRANSACTIONS & FULFILLMENT ====================

model Order {
  id           String      @id @default(uuid())
  userId       String
  supplierId   String
  variantId    String?
  qty          Int
  poolId       String?
  commitmentId String?     @unique
  unitPriceXaf Int
  amountXaf    Int
  status       OrderStatus @default(PENDING_PAYMENT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  deliveryType    DeliveryType @default(HUB_PICKUP)
  satelliteFeeXaf Int          @default(0)
  deliveryMethod  String?
  pickupPoint     String?
  deliveryAddress String?

  pool          Pool?           @relation("PoolOrders", fields: [poolId], references: [id])
  commitment    Commitment?     @relation(fields: [commitmentId], references: [id])
  payments      Payment[]       @relation("OrderPayments")
  purchaseOrder PurchaseOrder?  @relation("DirectOrder")
  user          User            @relation("UserOrders", fields: [userId], references: [id])
  supplier      Supplier        @relation("SupplierOrders", fields: [supplierId], references: [id])
  variant       ProductVariant? @relation("VariantOrders", fields: [variantId], references: [id])

  @@index([userId, createdAt])
  @@index([supplierId, createdAt])
  @@index([poolId])
  @@index([status])              // 🔥 Added: used by admin order status filter
  @@index([createdAt])           // 🔥 Added: used by admin date range filter
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String
  provider    String
  providerRef String?
  status      PaymentStatus @default(PENDING)
  amountXaf   Int
  rawWebhook  Json?
  createdAt   DateTime      @default(now())

  order Order @relation("OrderPayments", fields: [orderId], references: [id])

  @@index([orderId])
  @@unique([provider, providerRef])
}

model PurchaseOrder {
  id            String              @id @default(uuid())
  supplierId    String
  source        PurchaseOrderSource @default(POOL)
  poolId        String?             @unique
  directOrderId String?             @unique
  status        PurchaseOrderStatus @default(PENDING_SUPPLIER_CONFIRM)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  totalLogisticsSavingsXaf Int @default(0)

  supplier    Supplier           @relation(fields: [supplierId], references: [id])
  pool        Pool?              @relation(fields: [poolId], references: [id])
  directOrder Order?             @relation("DirectOrder", fields: [directOrderId], references: [id])
  items       PurchaseOrderItem[]
  events      FulfillmentEvent[]
}

model PurchaseOrderItem {
  id              String @id @default(uuid())
  purchaseOrderId String
  variantId       String
  qty             Int
  unitPriceXaf    Int

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
}

model FulfillmentEvent {
  id              String   @id @default(uuid())
  purchaseOrderId String
  status          String
  trackingCode    String?
  note            String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
}

// ==================== REWARDS & ENGAGEMENT ====================

model UserCheckIn {
  id          String   @id @default(uuid())
  userId      String
  checkInDate DateTime @default(now())
  reward      Int?
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, checkInDate])
}

model Reward {
  id        String   @id @default(uuid())
  title     String
  amount    Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReferralTransaction {
  id         String   @id @default(uuid())
  referrerId String
  refereeId  String
  amount     Int
  status     String   @default("COMPLETED")
  createdAt  DateTime @default(now())

  referrer User @relation("ReferrerLinks", fields: [referrerId], references: [id])
  referee  User @relation("RefereeLinks", fields: [refereeId], references: [id])
}

model RewardTransaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Int
  type        String   @default("OTHER")
  description String
  referenceId String?
  createdAt   DateTime @default(now())

  user User @relation("UserRewardTransactions", fields: [userId], references: [id])

  @@index([type])
}

// ==================== NOTIFICATIONS ====================

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String   // "android" | "ios" | "web"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserPushTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model InAppNotification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String   @default("INFO")  // "INFO" | "ORDER" | "POOL" | "SYSTEM" | "PROMO"
  isRead    Boolean  @default(false)
  deepLink  String?
  imageUrl  String?
  refId     String?
  createdAt DateTime @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model NotificationLog {
  id          String    @id @default(uuid())
  title       String
  body        String
  deepLink    String?
  audience    String
  channels    String[]
  status      String    @default("PENDING")   // "PENDING" | "SENT" | "FAILED" | "SCHEDULED"
  scheduledAt DateTime?
  sentAt      DateTime?
  pushCount   Int       @default(0)
  inAppCount  Int       @default(0)
  waCount     Int       @default(0)
  failCount   Int       @default(0)
  sentCount   Int       @default(0)            // 🔥 Added: used in notification history UI
  createdBy   String?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model WhatsAppLog {
  id           String   @id @default(uuid())
  userId       String?
  phone        String
  templateName String?
  message      String
  status       String   @default("PENDING")
  providerRef  String?
  error        String?
  createdAt    DateTime @default(now())

  @@index([phone])
  @@index([status])
}
